<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="hw3-model-switch" targetNamespace="https://rag-constructor.local/bpmn" exporter="RAG Constructor" exporterVersion="1.0">
  <bpmn:process id="Switch" isExecutable="false" name="Сервис контроля качества и переключения моделей — проектируемый процесс">
    <bpmn:startEvent id="s_start" name="Еженедельный таймер">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="WeeklyTimer">
        <bpmn:timeCycle>R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="s_load" name="Загрузить эталонные вопросы и ограничения">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="s_base" name="Оценить текущую LLM на эталонных вопросах">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="s_need" name="Качество ниже порога?" default="Flow_5">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_snapshot" name="Сохранить текущую конфигурацию для отката">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="s_choose" name="Выбрать следующую LLM из списка кандидатов">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="s_available" name="Есть кандидат и ресурс?" default="Flow_8">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="s_stable" name="Смена не требуется">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="s_stop" name="Записать причину остановки; сохранить текущую LLM">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="s_stopend" name="Без смены модели">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="s_eval" name="Оценить кандидата: качество, задержка, стоимость">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="s_accept" name="Все критерии выполнены?" default="Flow_17">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_switch" name="Переключить LLM проекта на кандидата">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="s_smoke" name="Выполнить контрольные запросы после смены">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="s_smokeok" name="Контроль пройден?" default="Flow_22">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_record" name="Сохранить версию, метрики и результат смены">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="s_success" name="Смена завершена">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="s_reject" name="Записать отказ кандидату или ошибку проверки">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="s_retry" name="Есть ещё попытки и бюджет?" default="Flow_20">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_exhausted" name="Зафиксировать неуспех; оставить прежнюю LLM">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="s_exhaustend" name="Лимиты исчерпаны">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="s_rollback" name="Восстановить предыдущую конфигурацию LLM">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="s_alert" name="Записать сбой; уведомить ответственного">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="s_rollbackend" name="Откат выполнен">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s_start" targetRef="s_load" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="s_load" targetRef="s_base" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="s_base" targetRef="s_need" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="s_need" targetRef="s_snapshot" name="Да">
      <bpmn:conditionExpression>Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="s_need" targetRef="s_stable" name="Нет" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="s_snapshot" targetRef="s_choose" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="s_choose" targetRef="s_available" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="s_available" targetRef="s_stop" name="Нет" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="s_stop" targetRef="s_stopend" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="s_available" targetRef="s_eval" name="Да">
      <bpmn:conditionExpression>Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="s_eval" targetRef="s_accept" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="s_accept" targetRef="s_switch" name="Да">
      <bpmn:conditionExpression>Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="s_switch" targetRef="s_smoke" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="s_smoke" targetRef="s_smokeok" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="s_smokeok" targetRef="s_record" name="Да">
      <bpmn:conditionExpression>Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="s_record" targetRef="s_success" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="s_accept" targetRef="s_reject" name="Нет" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="s_reject" targetRef="s_retry" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="s_retry" targetRef="s_choose" name="Да">
      <bpmn:conditionExpression>Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="s_retry" targetRef="s_exhausted" name="Нет" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="s_exhausted" targetRef="s_exhaustend" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="s_smokeok" targetRef="s_rollback" name="Нет" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="s_rollback" targetRef="s_alert" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="s_alert" targetRef="s_rollbackend" />
    <bpmn:textAnnotation id="Criteria">
      <bpmn:text>Пример проектных критериев (не результаты измерений):
качество ответов ≥ 85%; не хуже текущей LLM; p95 ≤ 10 с; стоимость ≤ заданного бюджета. Ошибка или тайм-аут проверки → отказ кандидату.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Criteria" sourceRef="s_accept" targetRef="Criteria" />
    <bpmn:textAnnotation id="Limits">
      <bpmn:text>Пример лимитов: максимум 3 кандидата и 30 минут на цикл. Проверять остаток бюджета перед каждым прогоном. При недоступности текущей LLM считать оценку неудовлетворительной.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Limits" sourceRef="s_retry" targetRef="Limits" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Participant_Switch" name="Сервис контроля качества и переключения моделей — проектируемый процесс" processRef="Switch" />
  </bpmn:collaboration>
