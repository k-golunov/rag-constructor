<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="hw2-operation" targetNamespace="https://rag-constructor.local/bpmn" exporter="RAG Constructor" exporterVersion="1.0">
  <bpmn:process id="Preparation" isExecutable="false" name="1. Администратор и RAG-система — подготовка базы знаний">
    <bpmn:startEvent id="p_start" name="Новые материалы">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="p_create" name="Создать проект; задать LLM и эмбеддер">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_upload" name="Загрузить документ через интерфейс">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="p_index" name="Парсинг → чанки → эмбеддинги → Qdrant">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p_ok" name="Обработка успешна?" default="Flow_7">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p_ready" name="Установить статус источника completed">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="p_end" name="База знаний готова">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="p_fail" name="Сообщить об ошибке обработки документа">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="p_badend" name="Документ не готов">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="p_start" targetRef="p_create" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="p_create" targetRef="p_upload" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="p_upload" targetRef="p_index" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="p_index" targetRef="p_ok" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="p_ok" targetRef="p_ready" name="Да">
      <bpmn:conditionExpression>Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="p_ready" targetRef="p_end" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="p_ok" targetRef="p_fail" name="Нет" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="p_fail" targetRef="p_badend" />
    <bpmn:textAnnotation id="PrepNote">
      <bpmn:text>Обобщён сценарий одиночной загрузки. Ошибка может возникнуть при чтении, векторизации или записи в индекс.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_PrepNote" sourceRef="p_index" targetRef="PrepNote" />
  </bpmn:process>
  <bpmn:process id="Question" isExecutable="false" name="2. Пользователь и RAG-система — ответ по подготовленной базе знаний">
    <bpmn:startEvent id="q_start" name="Нужна информация">
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="q_ask" name="Задать вопрос в чате проекта">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="q_history" name="Проверить настройки; загрузить историю">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="q_search" name="Векторизовать вопрос; найти фрагменты">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="q_searchok" name="Поиск выполнен?" default="Flow_14">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="q_context" name="Фрагменты найдены?" default="Flow_17">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="q_build" name="Собрать контекст и список источников">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="q_empty" name="Пустой контекст; статус no_context">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="q_merge" name="">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="q_generate" name="Вызвать LLM: вопрос, контекст и история">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="q_genok" name="Генерация успешна?" default="Flow_25">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="q_save" name="Сохранить вопрос, ответ и метаданные">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="q_show" name="Вернуть ответ и источники пользователю">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="q_end" name="Ответ получен">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="q_searcherror" name="Вернуть ошибку поиска (HTTP 502)">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="q_searchend" name="Без вызова LLM">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="q_generror" name="Вернуть ошибку LLM (HTTP 502)">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="q_genend" name="Ответ не сохранён">
      <bpmn:incoming>Flow_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="q_start" targetRef="q_ask" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="q_ask" targetRef="q_history" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="q_history" targetRef="q_search" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="q_search" targetRef="q_searchok" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="q_searchok" targetRef="q_context" name="Да">
      <bpmn:conditionExpression>Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="q_searchok" targetRef="q_searcherror" name="Нет" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="q_searcherror" targetRef="q_searchend" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="q_context" targetRef="q_build" name="Да">
      <bpmn:conditionExpression>Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="q_context" targetRef="q_empty" name="Нет" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="q_build" targetRef="q_merge" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="q_empty" targetRef="q_merge" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="q_merge" targetRef="q_generate" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="q_generate" targetRef="q_genok" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="q_genok" targetRef="q_save" name="Да">
      <bpmn:conditionExpression>Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="q_save" targetRef="q_show" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="q_show" targetRef="q_end" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="q_genok" targetRef="q_generror" name="Нет" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="q_generror" targetRef="q_genend" />
  </bpmn:process>
